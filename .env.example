# Vorlage fuer die private .env (nicht versionieren, Rechte 0600).
# Format: KEY=VALUE pro Zeile. Kein Shellcode: Anfuehrungszeichen, $() und
# Variablen werden NICHT ausgewertet. Nie mit `source` laden.

ENVIRONMENT=local
DJANGO_SECRET_KEY=<zufaelliger-schluessel>

# Entwicklungsdatenbank (MariaDB/MySQL, eigenes Konto)
DB_HOST=localhost
DB_PORT=
DB_NAME=<dev-datenbank>
DB_USER=<dev-konto>
DB_PASSWORD=<dev-passwort>

# Separate Testdatenbank mit eigenem, auf das Testschema begrenztem Konto
TEST_DB_HOST=localhost
TEST_DB_PORT=
TEST_DB_NAME=<test-datenbank>
TEST_DB_USER=<test-konto>
TEST_DB_PASSWORD=<test-passwort>

# Private Laufzeitdaten (Medien, lokale Testmails, Tile-Cache)
VAR_DIR=var

# Nur Produktion:
# ALLOWED_HOSTS=<host1>,<host2>
# EMAIL_HOST=<smtp-host>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp-konto>
# EMAIL_HOST_PASSWORD=<smtp-passwort>
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=<absender>
# TRUST_X_FORWARDED_PROTO=false

# Kartenquelle: local_test (lokale Testkacheln) oder swisstopo (budgetiertes Gateway)
MAP_TILE_SOURCE=local_test
